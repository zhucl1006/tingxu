{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tingxu",
  "version": "0.3.1",
  "identifier": "com.tingxu.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "tooltip": "听序 — AI 会议助手"
    },
    "windows": [
      {
        "label": "main",
        "title": "听序 — AI 会议助手",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "听序 — 专为个人办公打造的极简无感 AI 会议助手",
    "longDescription": "听序（Tingxu）是一款专注于中国大陆办公场景的高性能本地优先 AI 实时会议记录与智能纪要助手。",
    "category": "Productivity",
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
