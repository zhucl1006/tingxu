{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tingxu",
  "version": "0.2.0",
  "identifier": "com.tingxu.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "听序 Tingxu — AI 会议助手",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "floating-pill",
        "title": "听序 悬浮条",
        "width": 300,
        "height": 42,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "听序 — 专为个人办公打造的极简无感 AI 会议助手",
    "longDescription": "听序（Tingxu）是一款专注于中国大陆办公场景的高性能本地优先 AI 实时会议记录与智能纪要助手。",
    "category": "Productivity",
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
