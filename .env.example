# ==============================================================================
# 听序（Tingxu）— 云端服务与网关本地环境配置示例
# 可复制为 .env 文件自定义端口或大模型 API Key
# ==============================================================================

# 服务端口映射（默认已避开常用 3000/3001 端口冲突）
SERVER_PORT=3200
GATEWAY_PORT=3201
POSTGRES_PORT=5432

# 大模型 API 凭据（仅供网关使用，客户端严禁注入）
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# 阿里云百炼 Paraformer 实时流式 ASR 凭据
DASHSCOPE_API_KEY=

# 阿里云短信验证码发送凭据 (Dysmsapi)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=听序
ALIYUN_SMS_TEMPLATE_CODE=SMS_TINGXU_CODE

# 控制面数据库与安全凭据
JWT_SECRET=tingxu_jwt_secret_key_development_only
